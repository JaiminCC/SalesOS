# Local development. Copy to .env. These values are placeholders, not production secrets.
# Generate a 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

NODE_ENV=development

POSTGRES_USER=salesos
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=salesos
POSTGRES_PORT=5432

DATABASE_URL=postgresql://salesos:replace-with-a-long-random-password@127.0.0.1:5432/salesos
SALESOS_APP_PASSWORD=replace-with-a-different-long-random-password
DATABASE_URL_APP=postgresql://salesos_app:replace-with-a-different-long-random-password@127.0.0.1:5432/salesos
SALESOS_WORKER_PASSWORD=replace-with-a-third-long-random-password
DATABASE_URL_WORKER=postgresql://salesos_worker:replace-with-a-third-long-random-password@127.0.0.1:5432/salesos
SALESOS_IDENTITY_PASSWORD=replace-with-a-fourth-long-random-password
DATABASE_URL_IDENTITY=postgresql://salesos_identity:replace-with-a-fourth-long-random-password@127.0.0.1:5432/salesos
MAIL_MODE=capture

REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

DATA_ENCRYPTION_KEY=replace-with-32-byte-base64
INTERNAL_JOB_TOKEN=replace-with-at-least-16-chars

API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_DATA_SOURCE=demo
