# Production shape. Supply secrets from the host secret store. Do not commit a filled copy.
# infra/docker-compose.prod.yml does not publish database or Redis ports.

NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=https://salesos.example

POSTGRES_USER=salesos
POSTGRES_PASSWORD=replace-from-secret-store
POSTGRES_DB=salesos
DATABASE_URL=postgresql://salesos:replace-from-secret-store@postgres:5432/salesos
SALESOS_APP_PASSWORD=replace-from-secret-store
DATABASE_URL_APP=postgresql://salesos_app:replace-from-secret-store@postgres:5432/salesos
REDIS_URL=redis://redis:6379

DATA_ENCRYPTION_KEY=replace-from-secret-store
INTERNAL_JOB_TOKEN=replace-from-secret-store

NEXT_PUBLIC_API_BASE_URL=https://api.salesos.example
NEXT_PUBLIC_DATA_SOURCE=demo
