generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String    @unique
  status             String    @default("ACTIVE")
  timezone           String    @default("UTC")
  locale             String    @default("en")
  currency           String    @default("USD") @db.Char(3)
  settings           Json      @default("{}")
  automationStatus   String    @default("RUNNING") @map("automation_status")
  automationPausedAt DateTime? @map("automation_paused_at") @db.Timestamptz(6)
  automationPausedBy String?   @map("automation_paused_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships              Membership[]
  roles                    Role[]
  auditEvents              AuditEvent[]
  outboxEvents             OutboxEvent[]
  idempotencyKeys          IdempotencyKey[]
  jobExecutions            JobExecution[]
  invitations              Invitation[]
  products                 Product[]
  productVersions          ProductVersion[]
  knowledgeDocuments       KnowledgeDocument[]
  knowledgeChunks          KnowledgeChunk[]
  knowledgeEmbeddings      KnowledgeEmbedding[]
  embeddingIndex           EmbeddingIndex?
  productDefaults          OrganizationProductDefault?

  @@map("tenants")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailHmac         String    @unique @map("email_hmac")
  emailCiphertext   Bytes     @map("email_ciphertext")
  displayName       String    @map("display_name")
  passwordHash      String?   @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  status            String    @default("INVITED")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions             Session[]
  memberships          Membership[]
  mfaFactors           MfaFactor[]
  recoveryCodes        RecoveryCode[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent         String?   @map("user_agent")
  ipHash            String?   @map("ip_hash")
  mfaSatisfied      Boolean   @default(false) @map("mfa_satisfied")
  remember          Boolean   @default(false)
  activeTenantId    String?   @map("active_tenant_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model MfaFactor {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  secretCiphertext Bytes     @map("secret_ciphertext")
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  disabledAt       DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model AuthAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ipHash    String   @map("ip_hash")
  emailHmac String   @map("email_hmac")
  succeeded Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([emailHmac, createdAt])
  @@map("auth_attempts")
}

model Membership {
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("INVITED")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     MembershipRole[]

  @@id([tenantId, userId])
  @@map("memberships")
}

model Role {
  tenantId    String   @map("tenant_id") @db.Uuid
  id          String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     MembershipRole[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String
  role       Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, roleId, permission])
  @@map("role_permissions")
}

model MembershipRole {
  tenantId   String     @map("tenant_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  roleId     String     @map("role_id") @db.Uuid
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, userId, roleId])
  @@map("membership_roles")
}

model AuditEvent {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  tenantId      String    @map("tenant_id") @db.Uuid
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String    @map("event_type")
  schemaVersion Int       @default(1) @map("schema_version")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([status, createdAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  route       String
  requestHash String   @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("idempotency_keys")
}

model JobExecution {
  tenantId       String    @map("tenant_id") @db.Uuid
  id             String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queueName      String    @map("queue_name")
  jobName        String    @map("job_name")
  idempotencyKey String    @map("idempotency_key")
  status         String
  attempts       Int       @default(0)
  payload        Json      @default("{}")
  result         Json?
  errorCode      String?   @map("error_code")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@map("job_executions")
}

model Invitation {
  tenantId   String    @map("tenant_id") @db.Uuid
  id         String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailHmac  String    @map("email_hmac")
  roleName   String    @map("role_name")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  invitedBy  String?   @map("invited_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, emailHmac])
  @@map("invitations")
}

model SecurityEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  result    String
  requestId String?  @map("request_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("security_events")
}

model CapturedMessage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          String
  recipientHmac String   @map("recipient_hmac")
  token         String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recipientHmac, createdAt])
  @@map("captured_messages")
}

model Product {
  tenantId            String    @map("tenant_id") @db.Uuid
  id                  String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  productType         String    @map("product_type")
  category            String    @default("")
  shortDescription    String    @default("") @map("short_description")
  detailedDescription String    @default("") @map("detailed_description")
  website             String    @default("")
  status              String    @default("ACTIVE")
  tags                String[]  @default([])
  targetMarkets       String[]  @default([]) @map("target_markets")
  languages           String[]  @default([])
  currency            String    @default("USD") @db.Char(3)
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String    @map("updated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions            ProductVersion[]
  documents           KnowledgeDocument[]

  @@id([tenantId, id])
  @@index([tenantId, status, updatedAt])
  @@map("products")
}

model ProductVersion {
  tenantId      String    @map("tenant_id") @db.Uuid
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  versionNumber Int       @map("version_number")
  status        String
  revision      Int       @default(1)
  snapshot      Json
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by") @db.Uuid
  updatedBy     String    @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, productId, versionNumber])
  @@index([tenantId, productId, status])
  @@map("product_versions")
}

model KnowledgeDocument {
  tenantId           String    @map("tenant_id") @db.Uuid
  id                 String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  versionId          String?   @map("version_id") @db.Uuid
  fileName           String    @map("file_name")
  contentType        String    @map("content_type")
  byteSize           Int       @map("byte_size")
  sha256             String
  storageKey         String    @map("storage_key")
  status             String
  failureReason      String?   @map("failure_reason")
  semanticStatus     String    @default("UNAVAILABLE") @map("semantic_status")
  embeddingModel     String?   @map("embedding_model")
  pageCount          Int?      @map("page_count")
  replacesDocumentId String?   @map("replaces_document_id") @db.Uuid
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedReason     String?   @map("rejected_reason")
  retainUntil        DateTime? @map("retain_until") @db.Timestamptz(6)
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product            Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  chunks             KnowledgeChunk[]

  @@id([tenantId, id])
  @@unique([tenantId, sha256])
  @@index([tenantId, productId, status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  tenantId   String  @map("tenant_id") @db.Uuid
  id         String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String  @map("document_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  chunkIndex Int     @map("chunk_index")
  content    String
  page       Int?
  section    String?
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade)
  embedding  KnowledgeEmbedding?

  @@id([tenantId, id])
  @@unique([tenantId, documentId, chunkIndex])
  @@index([tenantId, productId])
  @@map("knowledge_chunks")
}

model KnowledgeEmbedding {
  tenantId   String   @map("tenant_id") @db.Uuid
  chunkId    String   @map("chunk_id") @db.Uuid
  model      String
  dimensions Int
  embedding  Unsupported("vector(384)")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunk      KnowledgeChunk @relation(fields: [tenantId, chunkId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, chunkId])
  @@map("knowledge_embeddings")
}

model EmbeddingIndex {
  tenantId   String   @id @map("tenant_id") @db.Uuid
  model      String
  dimensions Int
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("embedding_indexes")
}

model OrganizationProductDefault {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  positioning            Json     @default("{}")
  pricing                Json     @default("{}")
  knowledgeRetentionDays Int      @default(0) @map("knowledge_retention_days")
  updatedBy              String   @map("updated_by") @db.Uuid
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("organization_product_defaults")
}
