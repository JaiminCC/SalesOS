# Development overrides. Copy values into .env. Do not put real customer data here.
# Docker Compose publishes PostgreSQL and Redis on 127.0.0.1 only.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_DATA_SOURCE=demo
